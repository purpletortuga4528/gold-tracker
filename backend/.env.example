# Which price provider to use. Three ship, and none of them is a keyless
# working default any more. Reserves do not depend on any of this.
#
# "lbma" is the default and returns nothing. It read the daily LBMA auction
# benchmark with no key and history back to 1968, until LBMA closed its open
# feed in late 2026; the benchmark now needs a licence from ICE Benchmark
# Administration to obtain or redistribute. The adapter is kept for whoever can
# still reach the feed, and it fails with that explanation rather than a
# generic network error. Left as the default deliberately: an app with no price
# should say so, not quietly serve something else.
#
# "metalsdev" republishes the LBMA AM and PM fixes under a licence metals.dev
# holds. It needs a free key from metals.dev, set below. It has never been run
# and is marked unverified: see npm run verify:provider.
#
# "demo" is not a data source. It generates a price series so the app can be
# shown working, and every number it produces is invented. It says so on the
# page, in the API and in the startup banner. Set it deliberately or not at all.
#
# To add a fourth, see backend/src/services/priceProviders/README.md. Any key it
# needs stays server-side: the frontend never calls a provider and never
# receives a key, so never put one in a VITE_ variable.
PRICE_PROVIDER=lbma

# Required only by PRICE_PROVIDER=metalsdev. Free tier, no card, 100 requests
# a month. Never commit this file; .gitignore already covers it.
# METALS_DEV_API_KEY=your-key-here

# If you use metalsdev on the free tier, raise the two cache lifetimes below.
# 100 requests a month is about three a day, and the defaults further down
# (5 minutes and 6 hours) work out at roughly 8,760 a month, which spends the
# whole month's quota in well under a day. These two are what fits:
#   CACHE_SPOT_SECONDS=43200      12 hours: 2 requests a day
#   CACHE_HISTORY_SECONDS=86400   24 hours: 1 request a day
# That is 90 a month. A long spot lifetime is honest anyway, because the fix is
# set twice a day and a shorter one re-fetches a number that cannot have moved.
# The server prints this arithmetic at startup and says if it does not fit.

PORT=5174

# Which interface to listen on. Unset means every one, so starting the server
# and publishing it on your network are the same act. Set this to 127.0.0.1 to
# keep it to this machine. Under Docker, bind the published port instead:
# "127.0.0.1:5174:5174" in compose.yaml.
# HOST=127.0.0.1

# Serve the built frontend from this process, so self-hosting is one command on
# one port. Set to false during development, where Vite serves the app on 5173
# and proxies /api here; npm run dev already does this for you.
SERVE_FRONTEND=true

# How long to hold a price before re-fetching, in seconds. The LBMA benchmark
# only changes twice a day; keyed providers meter every call.
CACHE_SPOT_SECONDS=300
CACHE_HISTORY_SECONDS=21600

# Comma-separated allowed browser origins, or * to allow any.
CORS_ORIGINS=http://localhost:5173

# --- Keeping the data fresh ---------------------------------------------------
# The reserves snapshot is rebuilt from the IMF while the server runs, so a
# self-hosted copy does not quietly drift. Detecting staleness was never the
# hard part; acting on it is.
AUTO_REFRESH=true

# How often to check. IRFCL publishes monthly, so this only decides how soon
# after publication a long-running server notices.
AUTO_REFRESH_INTERVAL_HOURS=6

# How old the snapshot must be before a check actually rebuilds. This is what
# stops a rebuild running more often than the data can possibly change.
AUTO_REFRESH_MIN_AGE_HOURS=24

# --- Rate limiting -----------------------------------------------------------
# Requests per minute per client IP. Sized against what the app itself does: one
# Compare page load with six countries is 10 requests, which React StrictMode
# doubles to 20 in development. Browsing five pages uses about 15.
RATE_LIMIT_GENERAL=600

# /api/price/history?range=max returns 694 kB from a 67 byte request, so this is
# the bucket that actually caps egress. 45/min is roughly 31 MB/min.
RATE_LIMIT_PRICE_HISTORY=45

# Health has its own, higher allowance so a monitor polling it is never
# throttled into looking like an outage.
RATE_LIMIT_HEALTH=1200

# Express `trust proxy`. Leave unset when nothing is in front.
#
# This cuts both ways. Unset with no proxy: correct, and a forged
# X-Forwarded-For cannot be used to get a fresh bucket per request. Unset WITH a
# proxy in front: every request wears the proxy's address, so all your users
# share one bucket and the limits become a global cap. Set it when deploying
# behind a proxy, to a hop count or a specific address rather than `true`.
#
# Accepted: a hop count (1), an address, a comma separated list, or `loopback`.
# `false`, `off`, `no`, `0`, empty and unset all mean off. `true` trusts every
# hop, which makes the limits bypassable by anyone who sends the header.
# TRUST_PROXY=1
